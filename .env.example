# Copia questo file in .env.local e completa i valori.
# .env.local non finisce mai nel repository.
#
# Qui ci sono solo le variabili che il codice legge davvero. Se ne aggiungi
# una, deve comparire anche in `lib/env.ts` o nel modulo che la usa.

# --- Vercel AI Gateway ----------------------------------------------------
# Una sola chiave per testo, voce realtime, embedding e lettura del saldo.
# Serve sia in locale sia in produzione: e' l'unica strada di autenticazione
# del progetto. Su Vercel va aggiunta alle variabili d'ambiente.
AI_GATEWAY_API_KEY=

# --- Database -------------------------------------------------------------
# Connection string di Neon. Se manca, i tool leggono dal catalogo in memoria
# (agent/lib/catalog.ts) e la demo gira lo stesso.
DATABASE_URL=

# --- Modelli --------------------------------------------------------------
# Formato Gateway `creator/modello`. Cambiare modello e' cambiare questi
# valori: nessun identificativo e' scritto nel codice applicativo.

# L'agente che ragiona, sceglie le skill e chiama i tool.
AGENT_MODEL=anthropic/claude-sonnet-5

# La voce realtime (speech-to-speech) e la voce con cui parla.
# Attenzione ai Grok Voice: la doc del Gateway dice che reggono solo
# speech-to-speech e non la trascrizione, quindi con quelli la conversazione
# funziona ma la chat resta muta.
# Alternative: openai/gpt-realtime-2, openai/gpt-realtime-mini.
REALTIME_MODEL=openai/gpt-realtime-2.1
REALTIME_VOICE=alloy

# La trascrizione, che scrive in chat sia quello che dici tu sia quello che
# risponde l'avatar.
VOICE_STT_MODEL=openai/whisper-1

# Gli embedding per la ricerca semantica sulla documentazione del negozio.
# Servono solo col database collegato: senza, la ricerca e' per parole.
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Avatar ---------------------------------------------------------------
# Lascia vuoto per usare public/avatar/instructor.glb, che e' versionato.
# Accetta un percorso o un URL assoluto; vedi public/avatar/README.md.
NEXT_PUBLIC_AVATAR_URL=

# --- Sviluppo -------------------------------------------------------------
# Mostra in chat i tool che il concierge esegue, con la chiave inglese: serve
# a vedere che interroga davvero il negozio invece di inventare.
# Metti `false` quando si va live.
NEXT_PUBLIC_SHOW_TOOLS=true
