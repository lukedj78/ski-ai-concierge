# Copia questo file in .env.local e completa i valori.
# .env.local non finisce mai nel repository.

# --- Database -------------------------------------------------------------
# Connection string di Neon. Senza, l'interfaccia parte lo stesso: sono i tool
# che leggono magazzino e listino a fallire, con un messaggio esplicito.
DATABASE_URL=

# --- Vercel AI Gateway ----------------------------------------------------
# Una sola chiave per testo, trascrizione e sintesi vocale.
AI_GATEWAY_API_KEY=

# --- Modelli --------------------------------------------------------------
# Formato Gateway `creator/modello`. Cambiare modello e' cambiare questi
# valori: nessun identificativo di modello e' scritto nel codice applicativo.
AGENT_MODEL=anthropic/claude-sonnet-5
VOICE_AGENT_MODEL=anthropic/claude-haiku-4.5

# Voce. Attenzione: speech-to-text e text-to-speech sul Gateway sono in beta
# con rollout graduale — possono non essere nel catalogo del tuo team. In quel
# caso le rotte vocali rispondono 503 e la chat testuale continua a funzionare.
VOICE_STT_MODEL=openai/whisper-1
VOICE_TTS_MODEL=openai/tts-1
VOICE_TTS_VOICE=alloy

# Voce realtime (speech-to-speech): un solo salto invece di tre, ~300 ms.
# Alternative: openai/gpt-realtime-2.1, openai/gpt-realtime-mini,
# xai/grok-voice-think-fast-1.0.
REALTIME_MODEL=xai/grok-voice-think-fast-2.0
REALTIME_VOICE=alloy

# Embedding per la ricerca semantica sulla documentazione del negozio.
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Avatar ---------------------------------------------------------------
# Percorso o URL del modello 3D. Se manca, si vede una figura disegnata in
# geometria e l'app parte comunque.
# Accetta .glb (morph target ARKit / visemi Oculus) o .vrm (espressioni VRM),
# come file in public/avatar/ oppure come URL assoluto.
NEXT_PUBLIC_AVATAR_URL=
